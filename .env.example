# Live mode only. Copy to .env and fill in. Never commit real values.
# All three values come from the provider's official documentation and your own account.

# API key for the model provider. Server side only.
META_API_KEY=

# Full chat completions URL (not just the base URL), copied from the official docs.
META_API_URL=

# Model ID, copied from the official docs.
META_MODEL=
