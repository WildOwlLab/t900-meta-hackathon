# Live mode only. Copy to .env and fill in. Never commit real values.
# Leave all three of the first variables empty to run in fixture mode (the default).
# The values come from the provider's official documentation and your own account.

# API key for the model provider. Server side only.
META_API_KEY= 'LLM_1458554699002393_REDwRAentJx7fjWnkM0Nwkp96ec'

# The provider's OpenAI-compatible base URL, for example one ending in /v1.
# The server appends /chat/completions. A URL that already ends in /chat/completions also works.
META_API_URL= 'https://api.fireworks.ai/inference/v1'

# Model ID, copied from the provider's documentation.
META_MODEL= 'accounts/fireworks/models/muse-spark-open'

# Optional: json_schema (default) or json_object.
# json_schema sends the schema in response_format. json_object asks only for JSON and puts the schema in the prompt.
META_RESPONSE_FORMAT=
